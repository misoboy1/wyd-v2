# 복사: cp .env.example .env  →  값 채우기
# 무작위 값 만들기: openssl rand -base64 32

DB_PASSWORD=change-me-db-password
JWT_SECRET=change-me-at-least-32-random-characters

# 첫 기동 시 만들 관리자 계정(이미 계정이 있으면 무시). 로그인 후 반드시 비밀번호 변경
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# ngrok: https://dashboard.ngrok.com 가입 → Your Authtoken / Domains(무료 고정 도메인 1개)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=your-name.ngrok-free.app

# 선택
WYD_SYNC_ENABLED=true     # 매일 06:10 묵주기도 현황 수집
SEED_CONTENT=true         # 빈 DB에 기준 콘텐츠(시설 실측·일정·준비 단계·장소·고리기도) 채우기
COOKIE_SECURE=true        # https(ngrok) 사용 시 true. http://127.0.0.1:8080 로컬 확인만 할 때는 false
