{
  "name": "@wyd/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput & node --watch --env-file-if-exists=../../.env dist/main.js",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate.js",
    "seed:admin": "node dist/cli/seed-admin.js",
    "seed:demo": "node dist/cli/seed-demo.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:sheets": "node dist/cli/migrate-sheets.js",
    "test:smoke": "node test/smoke.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-fastify": "^12.1.0",
    "@node-rs/argon2": "^2.2.0",
    "@wyd/shared": "2.0.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.12.0",
    "postgres": "^3.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "sharp": "^0.35.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@fastify/static": "^9.0.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "typescript": "~5.9.0",
    "vitest": "^3.2.0"
  }
}
