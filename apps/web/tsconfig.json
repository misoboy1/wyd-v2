{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "noUnusedLocals": true,
    "paths": { "@/*": ["./src/*"], "@wyd/shared": ["../../packages/shared/src/index.ts"] }
  },
  "include": ["src"]
}
